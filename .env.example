NEXT_PUBLIC_ALCHEMY_API_KEY=

# Network Configuration
NEXT_PUBLIC_NETWORK=testnet # or 'mainnet'

# RPC URLs
NEXT_PUBLIC_TESTNET_RPC_URL=your_sonic_blaze_testnet_rpc_url
NEXT_PUBLIC_MAINNET_RPC_URL=your_sonic_mainnet_rpc_url

# Contract Addresses - Testnet
NEXT_PUBLIC_TESTNET_ORACLES_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_TESTNET_EXPLORERS_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_TESTNET_VORTEX_TOKEN_CONTRACT_ADDRESS=0x...

# Contract Addresses - Mainnet
NEXT_PUBLIC_MAINNET_ORACLES_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_MAINNET_EXPLORERS_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_MAINNET_VORTEX_TOKEN_CONTRACT_ADDRESS=0x...